# Copy to .env.local and fill in. Without the Supabase values the app runs on demo data.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_…). The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is still accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only, never NEXT_PUBLIC_. Optional: lets the app email chefs about new requests.
# Secret key (sb_secret_…); the legacy SUPABASE_SERVICE_ROLE_KEY is still accepted.
SUPABASE_SECRET_KEY=

# Public URL, used in emails and SEO (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: transactional email through Resend. Without it, emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="Ao Lume <reservas@aolume.com>"
# Where the team is told a profile or a certificate is waiting (defaults to verificacoes@aolume.com)
ADMIN_EMAIL=

# Optional: map style. Defaults to the free OpenFreeMap "positron" style (no key needed).
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Optional: Meta (Facebook/Instagram) Pixel ID, to measure ads. Build-time value.
# When set, the site shows a cookie banner and only loads the pixel after the visitor accepts.
# NEXT_PUBLIC_META_PIXEL_ID=

# --- Pagamentos (sinal pago na app, comissão, pagamento ao chef) -------------
# Master switch. Off, the site behaves exactly as before: no payment step anywhere.
PAYMENTS_ENABLED=false
# EuPago: sandbox.eupago.pt or clientes.eupago.pt
EUPAGO_ENV=sandbox
EUPAGO_API_KEY=
# Realtime Webhooks 2.0, from the EuPago backoffice: HMAC-SHA256 secret, and the AES-256-CBC key
# when the webhook is configured with encrypt=true.
EUPAGO_WEBHOOK_SECRET=
EUPAGO_WEBHOOK_ENCRYPTION_KEY=
# OAuth client credentials; refunds go through the management API, which does not take the API key.
EUPAGO_CLIENT_ID=
EUPAGO_CLIENT_SECRET=
# 32 bytes, base64 or hex: encrypts IBANs at rest, so a database dump alone reveals none.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy somewhere safe. Lose it and the stored IBANs are unreadable.
PAYOUT_ENCRYPTION_KEY=
# Shared secret for POST /api/payments/reconcile, the job that catches payments whose webhook
# never arrived. Call it every few minutes from cron with the x-reconcile-secret header.
RECONCILE_SECRET=

# The company bank account the chef payouts leave from. Only used to build the SEPA file an admin
# uploads to the bank; the app never moves money by itself.
PLATFORM_ACCOUNT_NAME=
PLATFORM_IBAN=
PLATFORM_BIC=
